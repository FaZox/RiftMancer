{
  "name": "riftmancer",
  "private": true,
  "version": "2.1.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/make-thumbs.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "thumbs": "node scripts/make-thumbs.mjs",
    "build:mobile": "node scripts/copy-ort.mjs && node scripts/make-thumbs.mjs && node scripts/build-mobile.mjs",
    "android:apk": "npm run build:mobile && node scripts/android-apk.mjs",
    "android:apk:test": "npm run build:mobile -- --test && node scripts/android-apk.mjs --test",
    "desktop": "npm run build && electron .",
    "desktop:start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "desktop:exe": "npm run build && node scripts/make-icons.mjs && node scripts/desktop-exe.mjs",
    "desktop:exe:test": "npm run build && node scripts/make-icons.mjs && node scripts/desktop-exe.mjs --test",
    "catalog:enrich": "node scripts/enrich-catalog.mjs",
    "catalog:update": "node scripts/update-catalog.mjs",
    "eval:matcher": "node scripts/eval-matcher.mjs",
    "photos:prepare": "node scripts/photos-prepare.mjs",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "pack:keygen": "node scripts/pack-keygen.mjs",
    "pack:sign": "node scripts/pack-sign.mjs",
    "test": "node scripts/run-tests.mjs",
    "content:import": "node scripts/content-import.mjs",
    "public:export": "node scripts/public-export.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "eval:detector": "node scripts/eval-detector.mjs",
    "bench:import": "node scripts/bench-import.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@tanstack/react-virtual": "3.10.8",
    "idb": "^8.0.0",
    "jsqr": "1.4.0",
    "lucide-react": "^0.263.1",
    "onnxruntime-web": "1.31.1",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "onnxruntime-node": "1.31.1",
    "postcss": "^8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "main": "electron/main.cjs",
  "description": "Scanner et gestionnaire de collection Riftbound",
  "author": "RiftMancer",
  "build": {
    "appId": "com.riftmancer.app",
    "productName": "RiftMancer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      { "from": "LICENSE", "to": "LICENSE.txt" },
      { "from": "THIRD_PARTY_LICENSES.md", "to": "THIRD_PARTY_LICENSES.md" }
    ],
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RiftMancer",
      "deleteAppDataOnUninstall": false
    }
  }
}
